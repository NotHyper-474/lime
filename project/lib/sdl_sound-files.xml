<xml>

    <set name="SDLSOUND_DECODER_MODPLUG" value="1" />
    <set name="SDLSOUND_DECODER_MIDI" value="1" />
    <set name="SDLSOUND_DECODER_COREAUDIO" value="1" if="mac || ios || tvos" />

    <set name="SDLSOUND_PATH" value="${NATIVE_TOOLKIT_PATH}/sdl3_sound" unless="LIME_SDL2_SOUND" />
    <set name="SDLSOUND_PATH" value="${NATIVE_TOOLKIT_PATH}/sdl_sound" unless="SDLSOUND_PATH" />

    <files id="native-toolkit-sdl_sound-depends">

        <depend name="${SDLSOUND_PATH}/src/dr_flac.h" />
        <depend name="${SDLSOUND_PATH}/src/dr_mp3.h" />
        <depend name="${SDLSOUND_PATH}/src/stb_vorbis.h" />
        <depend name="${SDLSOUND_PATH}/src/SDL_sound_internal.h" />

        <depend name="${SDLSOUND_PATH}/src/SDL_sound.h" unless="LIME_SDL3_SOUND" />
        <depend name="${SDLSOUND_PATH}/include/SDL3_sound/SDL_sound.h" if="LIME_SDL3_SOUND" />

        <section if="SDLSOUND_DECODER_MODPLUG">

            <depend name="${SDLSOUND_PATH}/src/libmodplug/libmodplug.h" />
            <depend name="${SDLSOUND_PATH}/src/libmodplug/modplug.h" />
            <depend name="${SDLSOUND_PATH}/src/libmodplug/tables.h" />

        </section>

        <section if="SDLSOUND_DECODER_MIDI">

            <depend name="${SDLSOUND_PATH}/src/timidity/common.h" />
            <depend name="${SDLSOUND_PATH}/src/timidity/instrum.h" />
            <depend name="${SDLSOUND_PATH}/src/timidity/mix.h" />
            <depend name="${SDLSOUND_PATH}/src/timidity/options.h" />
            <depend name="${SDLSOUND_PATH}/src/timidity/output.h" />
            <depend name="${SDLSOUND_PATH}/src/timidity/playmidi.h" />
            <depend name="${SDLSOUND_PATH}/src/timidity/readmidi.h" />
            <depend name="${SDLSOUND_PATH}/src/timidity/resample.h" />
            <depend name="${SDLSOUND_PATH}/src/timidity/tables.h" />
            <depend name="${SDLSOUND_PATH}/src/timidity/timidity.h" />

        </section>

    </files>

    <files id="native-toolkit-sdl_sound" tags="">

        <cache value="1" />
        <tag value="${NATIVE_TOOLKIT_OPTIM_TAG}" if="NATIVE_TOOLKIT_OPTIM_TAG" />

        <compilerflag value="-I${ANDROID_NDK_ROOT}/sources/android/cpufeatures" if="android" />

        <section if="LIME_SDL2_SOUND">
            <compilerflag value="-I${NATIVE_TOOLKIT_PATH}/custom/sdl/include/"/>
            <compilerflag value="-I${NATIVE_TOOLKIT_PATH}/sdl/include/" />
            <compilerflag value="-I${NATIVE_TOOLKIT_PATH}/sdl/src/hidapi/hidapi/" />
        </section>

        <section if="LIME_SDL3_SOUND">
            <compilerflag value="-I${NATIVE_TOOLKIT_PATH}/sdl3_sound/include" />
            <compilerflag value="-I${NATIVE_TOOLKIT_PATH}/custom/sdl3/"/>
            <compilerflag value="-I${NATIVE_TOOLKIT_PATH}/sdl3/include/" />
            <compilerflag value="-I${NATIVE_TOOLKIT_PATH}/sdl3/src/hidapi/hidapi/" />
        </section>

        <compilerflag value="-I${SDL_CONFIG_PATH}" if="SDL_CONFIG_PATH" />

        <compilerflag value="-DHAVE_LIBC" />
        <compilerflag value="-D__IPHONEOS__" if="ios || tvos" />
        <compilerflag value="-D__TVOS__" if="tvos" />

        <compilerflag value="-I${SDLSOUND_PATH}/src/" />

        <section if="winrt">

            <compilerflag value="-D__WINRT__" />
            <compilerflag value="-DUNICODE" />

        </section>

        <section if="linux">

            <compilerflag value="-D_REENTRANT" />
            <compilerflag value="-mmmx" unless="rpi" />
            <compilerflag value="-msse" unless="rpi" />
            <compilerflag value="-msse2" unless="rpi" />
            <compilerflag value="-msse3" unless="rpi" />
            <compilerflag value="-mssse3" unless="rpi" />

        </section>

            <section if="rpi">

                <compilerflag value="-mfpu=neon" unless="HXCPP_ARM64" />
                <compilerflag value="-mfloat-abi=hard" unless="HXCPP_ARM64" />
                <compilerflag value="-I-abi=hard" />

                <compilerflag value="-I/opt/vc/include" />
                <compilerflag value="-I/opt/vc/include/interface/vcos/pthreads" />
                <compilerflag value="-I/opt/vc/include/interface/vmcs_host/linux" />
                <compilerflag value="-I/usr/include/dbus-1.0" />
                <compilerflag value="-I/usr/include/interface/vcos/pthreads" />
                <compilerflag value="-I/usr/include/interface/vmcs_host/linux" />
                <compilerflag value="-I/usr/include/libdrm" />
                <compilerflag value="-I/usr/lib/arm-linux-gnueabihf/dbus-1.0/include" unless="HXCPP_ARM64" />
                <compilerflag value="-I/usr/lib/aarch64-linux-gnu/dbus-1.0/include" if="HXCPP_ARM64" />
                <compilerflag value="-I/usr/local/include" />

            </section>

        <section if="mac">

            <compilerflag value="-DTARGET_API_MAC_CARBON" />
            <compilerflag value="-DTARGET_API_MAC_OSX" />
            <compilerflag value="-D_THREAD_SAFE" />
            <compilerflag value="-mmmx" unless="HXCPP_ARM64" />
            <compilerflag value="-msse" unless="HXCPP_ARM64" />
            <compilerflag value="-msse2" unless="HXCPP_ARM64" />
            <compilerflag value="-msse3" unless="HXCPP_ARM64" />
            <compilerflag value="-mssse3" unless="HXCPP_ARM64" />

            <vflag name="-framework" value="AudioToolbox" if="SDLSOUND_DECODER_COREAUDIO" />

        </section>

        <section if="ios || tvos">

            <vflag name="-framework" value="AudioToolbox" if="SDLSOUND_DECODER_COREAUDIO" />

        </section>

        <file name="${SDLSOUND_PATH}/src/SDL_sound.c" />
        <file name="${SDLSOUND_PATH}/src/SDL_sound_aiff.c" />
        <file name="${SDLSOUND_PATH}/src/SDL_sound_au.c" />
        <file name="${SDLSOUND_PATH}/src/SDL_sound_coreaudio.c" />
        <file name="${SDLSOUND_PATH}/src/SDL_sound_flac.c" />
        <file name="${SDLSOUND_PATH}/src/SDL_sound_midi.c" />
        <file name="${SDLSOUND_PATH}/src/SDL_sound_modplug.c" />
        <file name="${SDLSOUND_PATH}/src/SDL_sound_mp3.c" />
        <file name="${SDLSOUND_PATH}/src/SDL_sound_raw.c" />
        <file name="${SDLSOUND_PATH}/src/SDL_sound_shn.c" />
        <file name="${SDLSOUND_PATH}/src/SDL_sound_voc.c" />
        <file name="${SDLSOUND_PATH}/src/SDL_sound_vorbis.c" />
        <file name="${SDLSOUND_PATH}/src/SDL_sound_wav.c" />

        <section if="SDLSOUND_DECODER_MODPLUG">

            <file name="${SDLSOUND_PATH}/src/libmodplug/fastmix.c" />
            <file name="${SDLSOUND_PATH}/src/libmodplug/load_669.c" />
            <file name="${SDLSOUND_PATH}/src/libmodplug/load_amf.c" />
            <file name="${SDLSOUND_PATH}/src/libmodplug/load_ams.c" />
            <file name="${SDLSOUND_PATH}/src/libmodplug/load_dbm.c" />
            <file name="${SDLSOUND_PATH}/src/libmodplug/load_dmf.c" />
            <file name="${SDLSOUND_PATH}/src/libmodplug/load_dsm.c" />
            <file name="${SDLSOUND_PATH}/src/libmodplug/load_far.c" />
            <file name="${SDLSOUND_PATH}/src/libmodplug/load_it.c" />
            <file name="${SDLSOUND_PATH}/src/libmodplug/load_mdl.c" />
            <file name="${SDLSOUND_PATH}/src/libmodplug/load_med.c" />
            <file name="${SDLSOUND_PATH}/src/libmodplug/load_mod.c" />
            <file name="${SDLSOUND_PATH}/src/libmodplug/load_mt2.c" />
            <file name="${SDLSOUND_PATH}/src/libmodplug/load_mtm.c" />
            <file name="${SDLSOUND_PATH}/src/libmodplug/load_okt.c" />
            <file name="${SDLSOUND_PATH}/src/libmodplug/load_gdm.c" />
            <file name="${SDLSOUND_PATH}/src/libmodplug/load_psm.c" />
            <file name="${SDLSOUND_PATH}/src/libmodplug/load_ptm.c" />
            <file name="${SDLSOUND_PATH}/src/libmodplug/load_s3m.c" />
            <file name="${SDLSOUND_PATH}/src/libmodplug/load_stm.c" />
            <file name="${SDLSOUND_PATH}/src/libmodplug/load_ult.c" />
            <file name="${SDLSOUND_PATH}/src/libmodplug/load_umx.c" />
            <file name="${SDLSOUND_PATH}/src/libmodplug/load_xm.c" />
            <file name="${SDLSOUND_PATH}/src/libmodplug/mmcmp.c" />
            <file name="${SDLSOUND_PATH}/src/libmodplug/modplug.c" />
            <file name="${SDLSOUND_PATH}/src/libmodplug/snd_dsp.c" />
            <file name="${SDLSOUND_PATH}/src/libmodplug/snd_flt.c" />
            <file name="${SDLSOUND_PATH}/src/libmodplug/snd_fx.c" />
            <file name="${SDLSOUND_PATH}/src/libmodplug/sndfile.c" />
            <file name="${SDLSOUND_PATH}/src/libmodplug/sndmix.c" />

        </section>

        <section if="SDLSOUND_DECODER_MIDI">

            <file name="${SDLSOUND_PATH}/src/timidity/common.c" />
            <file name="${SDLSOUND_PATH}/src/timidity/instrum.c" />
            <file name="${SDLSOUND_PATH}/src/timidity/mix.c" />
            <file name="${SDLSOUND_PATH}/src/timidity/output.c" />
            <file name="${SDLSOUND_PATH}/src/timidity/playmidi.c" />
            <file name="${SDLSOUND_PATH}/src/timidity/readmidi.c" />
            <file name="${SDLSOUND_PATH}/src/timidity/resample.c" />
            <file name="${SDLSOUND_PATH}/src/timidity/tables.c" />
            <file name="${SDLSOUND_PATH}/src/timidity/timidity.c" />

        </section>

    </files>

</xml>
